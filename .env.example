# Public frontend configuration. These values may be exposed to the browser,
# but the current frontend does not call Supabase directly.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public Edge Function URL used by the Contact form. This is not a secret.
VITE_LEAD_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/create-lead

# Server only — never prefix this value with VITE_ and never import it in React.
# It is reserved for a future API server or Supabase Edge Function.
SUPABASE_SERVICE_ROLE_KEY=

# Edge Function only — Resend notification settings. Never prefix these values
# with VITE_ and never import them in React or expose them to the browser.
RESEND_API_KEY=
LEAD_NOTIFICATION_TO=sales@example.com,team@example.com
LEAD_NOTIFICATION_FROM='Maîtrise Énergie <leads@example.com>'
# Optional fallback Reply-To. The prospect email is used by default.
LEAD_NOTIFICATION_REPLY_TO=

# Internal Edge Function only — never expose this value to a browser or a VITE_* variable.
LEAD_STATUS_API_KEY=

# Edge Function only — comma-separated origins allowed to call create-lead.
# Add the production domain at deployment time; do not use a wildcard.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required when producing the public sitemap during a production build.
SITE_URL=

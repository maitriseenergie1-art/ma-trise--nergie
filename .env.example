# ------------------------------------------------------------------
# Copy to .env for local development, or set these in the Netlify
# dashboard (Site settings → Environment variables) for production.
# ------------------------------------------------------------------

# --- Client / build (exposed to the browser) ---
VITE_SITE_URL=https://maitrise-energie.fr
SITE_URL=https://maitrise-energie.fr
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
# Lead ingestion endpoint. Default: the Netlify Function bundled in this repo.
VITE_LEAD_API_URL=/api/lead
VITE_TURNSTILE_SITE_KEY=

# --- Netlify Functions only — NEVER prefix with VITE_, never import in React ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
# OpenAI Ads Conversions API — server only. Never expose this key with VITE_.
OPENAI_CONVERSIONS_API_KEY=
# Optional override; the production Pixel ID is already the default in code.
OPENAI_ADS_PIXEL_ID=52KLrR3qwRDL3WJyDtXN5Z
# Facultatif : domaine attendu dans la réponse Siteverify. SITE_URL est utilisé par défaut.
TURNSTILE_EXPECTED_HOSTNAME=
# Access code for the /admin back office (choose a long random string).
ADMIN_ACCESS_CODE=

# --- Resend (Netlify Function /api/lead) — server only ---
# Notification interne + accusé de réception au visiteur.
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié dans Resend (adresse « no-reply »).
RESEND_FROM='Maîtrise Énergie <notifications@maitrise-energie.fr>'
LEAD_NOTIFICATION_TO=maitriseenergie1@gmail.com

# --- Supabase Edge Function (create-lead) — optional, only if you deploy it ---
RESEND_API_KEY=
LEAD_NOTIFICATION_TO=sales@example.com,team@example.com
LEAD_NOTIFICATION_FROM='Maîtrise Énergie <leads@example.com>'
LEAD_NOTIFICATION_REPLY_TO=
LEAD_STATUS_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

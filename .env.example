# ------------------------------------------------------------------
# Copy to .env for local development, or set these in the Netlify
# dashboard (Site settings → Environment variables) for production.
# ------------------------------------------------------------------

# --- Client / build (exposed to the browser) ---
VITE_SITE_URL=https://YOUR_DOMAIN
SITE_URL=https://YOUR_DOMAIN
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
# Lead ingestion endpoint. Default: the Netlify Function bundled in this repo.
VITE_LEAD_API_URL=/api/lead

# --- Netlify Functions only — NEVER prefix with VITE_, never import in React ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Access code for the /admin back office (choose a long random string).
ADMIN_ACCESS_CODE=

# --- Supabase Edge Function (create-lead) — optional, only if you deploy it ---
RESEND_API_KEY=
LEAD_NOTIFICATION_TO=sales@example.com,team@example.com
LEAD_NOTIFICATION_FROM='Maîtrise Énergie <leads@example.com>'
LEAD_NOTIFICATION_REPLY_TO=
LEAD_STATUS_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
